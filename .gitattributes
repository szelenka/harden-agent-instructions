# Ensure consistent LF line endings across platforms
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.tf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.kts text eol=lf

# Common text build/config files without reliable extensions
Makefile text eol=lf
Dockerfile text eol=lf
go.mod text eol=lf
go.sum text eol=lf
gradlew text eol=lf
meson.build text eol=lf
CMakeLists.txt text eol=lf
Pulumi.yaml text eol=lf
helmfile.yaml text eol=lf
tox.ini text eol=lf

# Keep common binary assets out of text normalization
*.png binary
