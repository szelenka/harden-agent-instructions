generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Invoice {
  id         String     @id @default(uuid())
  customerId String
  total      Float
  status     String     @default("draft")
  lineItems  LineItem[]
}

model LineItem {
  id          String  @id @default(uuid())
  description String
  amount      Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}
